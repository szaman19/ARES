# Required for live Gemini 4 Carbon, Hydrogen, and Decision-1 calls
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifiers (override if needed per Build with Gemini 4 Builder Guide)
GEMINI_CARBON_MODEL=gemini-4-carbon
GEMINI_HYDROGEN_MODEL=gemini-4-hydrogen
GEMINI_DECISION_MODEL=gemini-decision-1

# Shopify / shop.dev MCP configuration
SHOP_MCP_URL=https://mcp.shop.com
# Optional Global Catalog API bearer / key if using higher-rate authenticated catalog
SHOP_CATALOG_API_KEY=

# Optional runtime tuning
LEDGER_MAX_CONCURRENT_SEGMENTS=4
LEDGER_MAX_PROBE_ITEMS=8
LEDGER_REPLAY_MODE=false
